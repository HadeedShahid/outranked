# Supabase — server-side only. The service-role key must never reach the
# browser, so neither of these is prefixed NEXT_PUBLIC_.
SUPABASE_URL=https://cmjymlzhayacloumhttr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile — bot protection on claim.
# The site key is public (rendered in the widget); the secret key is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — outranked / spot-open notifications.
RESEND_API_KEY=
EMAIL_FROM="Outrank <notifications@yourdomain.com>"

# Admin removal route (spec A-1). Any long random string.
ADMIN_SECRET=


# Google AdSense. Leave blank to show "feature your business here" placeholders
# instead of ad units.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_RAIL=
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=
